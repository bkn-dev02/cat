# Select local or production configuration.
APP_ENV=local
APP_DEBUG=true

# Local application URL; replace the host with your computer's IP if needed.
APP_URL=http://127.0.0.1/cat

# Local CAT database
DB_HOST=localhost
DB_DATABASE=cat_enterprise
DB_USERNAME=root
DB_PASSWORD=

# Optional external databases used by the application
ELEARNING_DB_HOST=localhost
ELEARNING_DB_DATABASE=db_elearning
ELEARNING_DB_USERNAME=root
ELEARNING_DB_PASSWORD=

PPDB_DB_HOST=localhost
PPDB_DB_DATABASE=ppdb_bkn_hostinger
PPDB_DB_USERNAME=root
PPDB_DB_PASSWORD=

# Production settings; replace placeholders with your server's values.
PROD_DB_HOST=localhost
PROD_DB_DATABASE=change_me
PROD_DB_USERNAME=change_me
PROD_DB_PASSWORD=change_me

PROD_ELEARNING_DB_HOST=localhost
PROD_ELEARNING_DB_DATABASE=change_me
PROD_ELEARNING_DB_USERNAME=change_me
PROD_ELEARNING_DB_PASSWORD=change_me

PROD_PPDB_DB_HOST=localhost
PROD_PPDB_DB_DATABASE=change_me
PROD_PPDB_DB_USERNAME=change_me
PROD_PPDB_DB_PASSWORD=change_me
PROD_APP_URL=https://example.com
