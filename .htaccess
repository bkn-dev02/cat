<IfModule mod_security.c>
SecRuleRemoveById 400011
SecRuleRemoveById 400012
</IfModule>

RewriteEngine On

# Redirect favicon.ico to cat.png
RewriteRule ^favicon\.ico$ assets/cat.png [R=301,L]

# Halaman download langsung akses file PHP
RewriteRule ^download/?$ download.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

Options -Indexes
AddDefaultCharset UTF-8
AddType application/wasm .wasm
AddType font/woff2 .woff2
